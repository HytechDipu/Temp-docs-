# astar cities heuristic
from heapq import heappush, heappop
graph = {
    'arad': {'sibiu': 140, 'timisoara': 118, 'zerind': 75},
    'sibiu': {'arad': 140, 'fagaras': 99, 'riminicu': 80},
    'fagaras': {'sibiu': 99, 'bucharest': 211},
    'riminicu': {'sibiu': 80, 'p': 97},
    'p': {'riminicu': 97, 'bucharest': 101},
    'bucharest': {}
}
h = {
    'arad': 365,
    'sibiu': 253,
    'fagaras': 176,
    'riminicu': 193,
    'p': 100,
    'bucharest': 0,
    'timisoara': 329,
    'zerind': 374
}
def astar(start, goal):
    pq = [(h[start], 0, start, [start])]
    while pq:
        f, g, node, path = heappop(pq)
        if node == goal:
            return node, g
        for next_node, cost in graph.get(node, {}).items():
            new_g = g + cost
            new_f = new_g + h[next_node]
            heappush(pq, (new_f, new_g, next_node, path + [next_node]))
path, distance = astar("arad", "bucharest")
print("path:", "->".join(path))
print("distance=", distance)

