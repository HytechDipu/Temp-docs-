import heapq import heappush,heappop
goal = ((1, 2, 3),
        (4, 5, 6),
        (7, 8, 0))
def h(s):
    d = 0
    for i in range(3):
       or j in range(3):
            n = s[i][j]
            if n:
                x, y = divmod(n - 1, 3)
                d += abs(i - x) + abs(j - y)
    return d
def astar(start):
    pq = [(h(start), 0, start, [start])]
    seen = set()
    while pq:
        f, g, s, path = heapq.heappop(pq)
        if s == goal:
            for i, p in enumerate(path):
                print("Step:", i)
                for r in p:
                    print(r)
                print()
            print("Total distance =", g)
            return
        if s in seen:
            continue
        seen.add(s)
        for i in range(3):
            for j in range(3):
                if s[i][j] == 0:
                    x, y = i, j
        for dx, dy in [(1, 0), (-1, 0),
                       (0, 1), (0, -1)]:
            ni, nj = x + dx, y + dy
            if 0 <= ni < 3 and 0 <= nj < 3:
                t = [list(r) for r in s]
                t[x][y], t[ni][nj] = t[ni][nj], t[x][y]
                t = tuple(map(tuple, t))
                if t not in seen:
                    heapq.heappush(
                        pq, (g + 1 + h(t), g + 1,
                             t, path + [t])
                    )
