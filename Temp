#uniform cost search 
import heapq
def UCS(graph, start, goal):
    pq = [(0, start, [start])]
    visited = set()
    while pq:
        cost, node, path = heapq.heappop(pq)
        if node == goal:
            return path, cost
        if node not in visited:
            visited.add(node)
            for neighbour, weight in graph[node]:
                heapq.heappush(
                    pq,
                    (cost + weight, neighbour, path + [neighbour])
                )
    return None, float('inf')
